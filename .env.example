# ---------------------------------------------------------------------------
# LegalEdge Phase 1.1 — environment template.
# Copy to .env and replace every value. .env is git-ignored and must never be
# committed. Variables with no default are required: the process refuses to
# start without them (app/core/config.py).
# ---------------------------------------------------------------------------

# -- application ------------------------------------------------------------
APP_ENV=local                      # local | ci | staging | production
APP_NAME=legaledge-api
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                     # false gives human-readable console logs

# -- database (REQUIRED) ----------------------------------------------------
# Host name is the compose service name when running in Docker.
DATABASE_URL=postgresql://legaledge:legaledge@localhost:5432/legaledge
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_ECHO=false

# Consumed by compose.yml when it starts the postgres service.
POSTGRES_USER=legaledge
POSTGRES_PASSWORD=legaledge
POSTGRES_DB=legaledge
POSTGRES_PORT=5432
API_PORT=8000

# -- cache (optional; the service is behind the "cache" compose profile) -----
# REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# -- auth (REQUIRED) --------------------------------------------------------
# At least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-plus-characters-of-random
JWT_ACCESS_TTL=900                 # seconds (15 minutes)
JWT_REFRESH_TTL=1209600            # seconds (14 days)

# -- credential envelope encryption (REQUIRED) ------------------------------
# Exactly 32 raw bytes, base64-encoded, for AES-256-GCM.
# Generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# -- retrieval models -------------------------------------------------------
# Dense retriever: fine-tuned on 27 Indian Acts + the Constitution, 768 dims,
# 512-token ceiling. NOT BGE-M3 — see docs/adr/0001.
EMBED_MODEL=NyayaLabs98/nyaya-embed-v1
# Exact commit SHA. Never "main": these are small, new repositories.
# Resolved and pinned in Stage 3; an empty value fails loudly at model load.
EMBED_MODEL_REVISION=dd24436f0f30a262f30e7457c8d5fc07b9a069c6
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e

# HF_HOME. A fixed directory so both repositories download exactly once and
# every later stage (and the container, via the model-cache volume) reuses them.
MODEL_CACHE_DIR=var/model_cache
EMBED_BATCH_SIZE=16

# -- retrieval tuning -------------------------------------------------------
RETRIEVAL_TOP_K=30                 # top-k per retriever before RRF
RERANK_TOP_N=6                     # blocks packed into the prompt
RERANK_SCORE_FLOOR=0.30            # below this the API abstains without an LLM call
MAX_CHUNK_TOKENS=450               # must stay under the model's 512-token limit
RRF_K=60                           # Reciprocal Rank Fusion constant (spec 05)
CONTEXT_BUDGET_TOKENS=12000        # ceiling on the packed corpus blocks

# -- generation -------------------------------------------------------------
# One key for now; the per-user BYOK vault is Stage 7. An empty LLM_API_KEY is
# not a crash: POST /v1/ask returns the typed 402 missing_provider_key.
LLM_MODEL=anthropic/claude-sonnet-4-5
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=60

# -- query rewriting --------------------------------------------------------
# Runs only when a request carries prior turns. Blank REWRITE_MODEL means
# "same as LLM_MODEL"; point it at something cheaper if you like.
REWRITE_ENABLED=true
REWRITE_MODEL=
REWRITE_MAX_TOKENS=160
REWRITE_TIMEOUT_SECONDS=15

# -- corpus pipeline --------------------------------------------------------
CORPUS_ARCHIVE_DIR=var/corpus_archive
CORPUS_ARCHIVE_HOST_DIR=./var/corpus_archive
# Government portals are entitled to know who is fetching; a contact is required.
FETCH_USER_AGENT=LegalEdgeKB/0.1 (+https://recklabs.ai/legaledge; contact: legal-kb@recklabs.com)
FETCH_DELAY_SECONDS=2.0

# -- observability (all optional) -------------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-00000000-0000-0000-0000-000000000000
# LANGFUSE_SECRET_KEY=sk-lf-00000000-0000-0000-0000-000000000000
# LANGFUSE_HOST=http://localhost:3001
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# -- production overlay only (compose.prod.yml) -----------------------------
# LEGALEDGE_DOMAIN=kb.example.com
# LEGALEDGE_TLS_EMAIL=ops@example.com

# -- image build ------------------------------------------------------------
# true also installs docling/ocrmypdf/datasets (~1.5 GB) for running the CLI
# inside the container. The API path never needs them.
INSTALL_CORPUS=false
